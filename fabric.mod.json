{
  "schemaVersion": 1,
  "id": "mccinametagmod",
  "version": "${version}",
  "name": "Own Nametag",
  "description": "Shows your own name tag (with your server rank/tag) above your head in third person, on any server.",
  "authors": [
    "anastarawneh"
  ],
  "contact": {
    "sources": "https://github.com/anastarawneh/MCCINametagMod",
    "issues": "https://github.com/anastarawneh/MCCINametagMod/issues"
  },
  "license": "MIT",
  "icon": "assets/mccinametagmod/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "me.anastarawneh.mccinametagmod.MCCINametagMod"
    ],
    "modmenu": [
      "me.anastarawneh.mccinametagmod.config.ModMenuScreen"
    ]
  },
  "mixins": [
    "mccinametagmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": "*"
